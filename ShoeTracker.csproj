<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>ShoeTracker</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- SQLite provider - includes UseSqlite() and LINQ to SQL translation -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
        <!--
            Only of use during development, to the "dotnet ef" tool to generate the migrations.
            PrivateAssets/IncludeAssets are the standard boilerplate that dotnet itself generates
            when adding this package: prevents the dependency from leaking to anyone who might reference
            this project as a library in the future.
        -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    </ItemGroup>

</Project>